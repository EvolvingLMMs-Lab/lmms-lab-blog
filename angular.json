{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "lmms-lab-blog": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "content/posts",
                "output": "posts",
                "ignore": [
                  "**/*.md",
                  "**/*.html",
                  "**/.gitkeep"
                ]
              },
              {
                "glob": "roboto-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/roboto/files",
                "output": "fonts"
              },
              {
                "glob": "roboto-latin-wght-italic.woff2",
                "input": "node_modules/@fontsource-variable/roboto/files",
                "output": "fonts"
              },
              {
                "glob": "space-grotesk-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/space-grotesk/files",
                "output": "fonts"
              },
              {
                "glob": "google-sans-code-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/google-sans-code/files",
                "output": "fonts"
              }
            ],
            "styles": [
              "node_modules/modern-normalize/modern-normalize.css",
              "node_modules/@fontsource-variable/roboto/index.css",
              "node_modules/@fontsource-variable/roboto/wght-italic.css",
              "node_modules/@fontsource-variable/space-grotesk/index.css",
              "node_modules/@fontsource-variable/google-sans-code/index.css",
              "node_modules/@phosphor-icons/web/src/regular/style.css",
              "src/styles.css",
              "node_modules/vidstack/player/styles/default/theme.css",
              "node_modules/vidstack/player/styles/default/layouts/video.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": {
                  "inline": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "lmms-lab-blog:build:production"
            },
            "development": {
              "buildTarget": "lmms-lab-blog:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
