{
  "name": "lmms-lab-blog",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "node scripts/build-posts.mjs",
    "prebuild": "pnpm generate:data",
    "prestart": "pnpm generate:data",
    "pretest": "pnpm generate:data",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "pnpm build && wrangler deploy",
    "watch": "pnpm generate:data && ng build --watch --configuration development",
    "test": "pnpm test:content && ng test",
    "test:content": "node --test scripts/lib/*.test.mjs",
    "biome:check": "biome check .",
    "biome:write": "biome check --write ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-server": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/ssr": "^21.2.12",
    "@fontsource-variable/google-sans-code": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@phosphor-icons/web": "^2.1.2",
    "@shikijs/transformers": "^4.1.0",
    "flexsearch": "^0.8.212",
    "marked": "^18.0.4",
    "medium-zoom": "^1.1.0",
    "modern-normalize": "^3.0.1",
    "rxjs": "~7.8.0",
    "shiki": "^4.1.0",
    "tslib": "^2.3.0",
    "vidstack": "1.15.6"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@biomejs/biome": "^2.4.15",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.118.0"
  }
}
