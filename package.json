{
  "name": "lmms-lab-blog",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "node scripts/build-posts.mjs",
    "prebuild": "pnpm generate:data",
    "prestart": "pnpm generate:data",
    "pretest": "pnpm generate:data",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "pnpm build && wrangler deploy",
    "watch": "pnpm generate:data && ng build --watch --configuration development",
    "test": "pnpm test:content && ng test",
    "test:content": "node --test scripts/lib/*.test.mjs",
    "biome:check": "biome check .",
    "biome:write": "biome check --write ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@fontsource-variable/google-sans-code": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@phosphor-icons/web": "^2.1.2",
    "flexsearch": "^0.8.212",
    "hls.js": "1.6.16",
    "medium-zoom": "^1.1.0",
    "modern-normalize": "^3.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vidstack": "1.15.6"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "^2.5.7",
    "@shikijs/transformers": "^4.4.2",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "shiki": "^4.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
